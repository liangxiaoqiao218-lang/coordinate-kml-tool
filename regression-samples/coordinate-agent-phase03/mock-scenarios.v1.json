{
  "schemaVersion": "coordinate-agent-offline-scenarios/v1",
  "purpose": "Offline test data only. Expected answers must never be imported by production prompts, parsers, or routing.",
  "scenarios": [
    {
      "id": "generic-confirmed-multigroup",
      "image": "fixtures/长坐标.png",
      "turns": [
        {
          "observation": {
            "summary": "A coordinate document requires closer inspection of orientation, headers, and rows.",
            "orientationDegrees": 0,
            "regions": [
              { "id": "whole", "kind": "document", "bbox": [0, 0, 1, 1], "sourceText": "", "semanticRole": "whole document", "confidence": 0.95, "provenance": "mock_visual_observation" }
            ]
          },
          "plan": {
            "rationale": "Prepare a normalized overview and inspect the header and row regions.",
            "actions": [
              { "id": "normalize", "toolName": "rotate_image", "objective": "Normalize visible orientation", "args": { "imageRef": "$IMAGE_REF", "degrees": 0 } },
              { "id": "table-crop", "toolName": "crop_region", "objective": "Inspect the main table", "args": { "imageRef": "$IMAGE_REF", "bbox": [0.05, 0.05, 0.95, 0.95] } },
              { "id": "header-zoom", "toolName": "zoom_region", "objective": "Inspect header direction evidence", "args": { "imageRef": "$IMAGE_REF", "bbox": [0.1, 0.1, 0.9, 0.4], "scale": 2 } }
            ]
          }
        },
        {
          "observation": {
            "summary": "The tool results provide sufficient header, row, and grouping evidence.",
            "orientationDegrees": 0,
            "regions": [
              { "id": "header", "kind": "header", "bbox": [0.1, 0.1, 0.9, 0.2], "sourceText": "Latitude N | Longitude E", "semanticRole": "column directions", "confidence": 0.99, "provenance": "mock_visual_review" },
              { "id": "rows", "kind": "table", "bbox": [0.1, 0.2, 0.9, 0.9], "sourceText": "three visible coordinate rows", "semanticRole": "coordinate rows", "confidence": 0.99, "provenance": "mock_visual_review" }
            ]
          },
          "plan": { "rationale": "No further visual action is required.", "actions": [] },
          "candidate": {
            "success": true,
            "resultStatus": "usable",
            "displayText": "P1 | 10.5 N | 20.25 E\nP2 | 11.5 N | 21.25 E\n\nP3 | 12.5 N | 22.25 E",
            "coordinateSystem": { "kind": "geographic", "name": "WGS 84", "epsg": "4326", "status": "identified" },
            "geometryType": "MultiPoint",
            "groups": [
              {
                "name": "Group A",
                "points": [
                  { "label": "P1", "sourceText": "P1 | 10.5 N | 20.25 E", "x": null, "y": null, "latitude": 10.5, "longitude": 20.25, "needsReview": false },
                  { "label": "P2", "sourceText": "P2 | 11.5 N | 21.25 E", "x": null, "y": null, "latitude": 11.5, "longitude": 21.25, "needsReview": false }
                ]
              },
              {
                "name": "Group B",
                "points": [
                  { "label": "P3", "sourceText": "P3 | 12.5 N | 22.25 E", "x": null, "y": null, "latitude": 12.5, "longitude": 22.25, "needsReview": false }
                ]
              }
            ],
            "warnings": []
          },
          "uncertainties": [],
          "reviewItems": []
        }
      ],
      "expected": {
        "terminalState": "CONFIRMED",
        "reviewFieldPaths": [],
        "groups": [
          { "points": [
            { "latitude": 10.5, "longitude": 20.25, "directionTokens": ["N", "E"] },
            { "latitude": 11.5, "longitude": 21.25, "directionTokens": ["N", "E"] }
          ] },
          { "points": [
            { "latitude": 12.5, "longitude": 22.25, "directionTokens": ["N", "E"] }
          ] }
        ]
      }
    },
    {
      "id": "generic-direction-review",
      "image": "fixtures/模糊坐标.jpg",
      "turns": [
        {
          "observation": {
            "summary": "A direction marker is not clear in the overview.",
            "orientationDegrees": 0,
            "regions": [
              { "id": "whole-review", "kind": "document", "bbox": [0, 0, 1, 1], "sourceText": "", "semanticRole": "whole document", "confidence": 0.7, "provenance": "mock_visual_observation" }
            ]
          },
          "plan": {
            "rationale": "Crop and enlarge the ambiguous direction marker.",
            "actions": [
              { "id": "direction-crop", "toolName": "crop_region", "objective": "Isolate direction evidence", "args": { "imageRef": "$IMAGE_REF", "bbox": [0.55, 0.1, 0.95, 0.45] } },
              { "id": "direction-zoom", "toolName": "zoom_region", "objective": "Enlarge direction evidence", "args": { "imageRef": "$IMAGE_REF", "bbox": [0.55, 0.1, 0.95, 0.45], "scale": 3 } }
            ]
          }
        },
        {
          "observation": {
            "summary": "The direction marker remains visually unresolved after focused review.",
            "orientationDegrees": 0,
            "regions": [
              { "id": "direction-review", "kind": "direction", "bbox": [0.55, 0.1, 0.95, 0.45], "sourceText": "?", "semanticRole": "longitude direction", "confidence": 0.35, "provenance": "mock_visual_review" }
            ]
          },
          "plan": { "rationale": "Stop automatic processing and request precise review.", "actions": [] },
          "candidate": {
            "success": true,
            "resultStatus": "needs_review",
            "displayText": "P1 | 10.5 N | 20.25 ?",
            "coordinateSystem": { "kind": "geographic", "name": "WGS 84", "epsg": "4326", "status": "needs_confirmation" },
            "geometryType": "Unknown",
            "groups": [
              { "name": "Observed group", "points": [
                { "label": "P1", "sourceText": "P1 | 10.5 N | 20.25 ?", "x": null, "y": null, "latitude": 10.5, "longitude": 20.25, "needsReview": true }
              ] }
            ],
            "warnings": ["Longitude direction requires confirmation"]
          },
          "uncertainties": [
            { "code": "DIRECTION_NOT_VISUALLY_RESOLVED", "message": "Longitude direction remains ambiguous", "evidenceRegionIds": ["direction-review"], "blocking": true }
          ],
          "reviewItems": [
            { "fieldPath": "coordinateGroups[0].points[0].longitudeDirection", "question": "Confirm the visible longitude direction", "evidenceRegionIds": ["direction-review"], "candidates": ["east", "west"] }
          ]
        }
      ],
      "expected": {
        "terminalState": "REVIEW_REQUIRED",
        "reviewFieldPaths": ["coordinateGroups[0].points[0].longitudeDirection"],
        "unresolvedDirectionFieldPaths": ["coordinateGroups[0].points[0].longitudeDirection"],
        "groups": [
          { "points": [
            { "latitude": 10.5, "longitude": 20.25, "directionTokens": [] }
          ] }
        ]
      }
    }
  ]
}
