{
  "schema_version": "coordinate_recognition_golden_baseline_v1",
  "status": "draft",
  "purpose": "Golden regression baseline and release gate for Coordinate Recognition Reliability Phase 1.",
  "created_at": "2026-07-11",
  "notes": [
    "This file is machine-readable and is the unified index over existing regression-samples/*/baseline.json files plus currently known real local image fixtures.",
    "Do not treat samples with baseline_status=missing or partial as blocking stable gates until their expected coordinates are manually confirmed.",
    "Image Pipeline 1500/0.8 is experimental only. It must not become default until this baseline passes without regression."
  ],
  "test_paths": [
    {
      "id": "original",
      "name": "Original image upload",
      "image_pipeline": {
        "enabled": false
      }
    },
    {
      "id": "image_pipeline_1500_80",
      "name": "Image Pipeline 1500 / 0.8",
      "image_pipeline": {
        "enabled": true,
        "profile": "1500-80",
        "max_side": 1500,
        "jpeg_quality": 0.8
      }
    }
  ],
  "success_levels": {
    "level_1_type_correct": [
      "coordinate_type matches expected_coordinate_type when provided",
      "V2 precision_mode matches expected_v2_precision_mode; V1 precisionMode is checked separately as legacy unless v1_precision_mode_blocker=true",
      "groupCount matches expected_group_count",
      "result is not captured by forbidden precision modes or fallbacks"
    ],
    "level_2_coordinate_correct": [
      "pointCount matches expected_point_count",
      "firstPoint matches expected_first_point within tolerance",
      "lastPoint matches expected_last_point within tolerance",
      "point order is preserved",
      "coordinates are not swapped or silently converted into the wrong axis order"
    ],
    "level_3_output_safe": [
      "geometry matches expected_geometry",
      "requires_review matches expected_requires_review",
      "kml_ready matches expected_kml_ready",
      "self-intersecting groups are blocked",
      "failed recognition does not produce trusted KML",
      "local OCR does not package complex garbage as a valid coordinate result"
    ]
  },
  "failure_taxonomy": [
    "vision_timeout",
    "vision_transcription_error",
    "wrong_coordinate_type",
    "detector_priority_error",
    "parser_error",
    "axis_order_error",
    "group_detection_error",
    "point_loss",
    "point_order_error",
    "projection_error",
    "fallback_takeover",
    "frontend_display_only",
    "baseline_incorrect"
  ],
  "release_gate": {
    "stable_core_samples_must_pass": true,
    "stable_core_required_success_rate": 1,
    "high_risk_repeat_count": 10,
    "core_repeat_count": 5,
    "forbid_complex_local_ocr_final_result": true,
    "forbid_old_sample_regression": true,
    "handwritten_dms_status": "experimental",
    "handwritten_dms_rule": "Failures must return a clear review/retry message and must not generate garbage KML."
  },
